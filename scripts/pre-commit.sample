#!/bin/sh
# DevChain config invariants — local pre-commit hook.
#
# THIS HEADER IS THE CANONICAL INSTALL DOCUMENTATION. scripts/README.md and
# docs/setup.md point here rather than repeating it, so there is one copy to
# keep true.
#
# HOOK-VERSION: 3
# (the value above must stay ALONE on its line — a trailing comment made it
#  unparseable to an end-anchored regex, which then yielded empty on BOTH sides
#  and compared EQUAL. Bump it whenever this file changes; see "Staleness".)
#
# Install — COPY, not a symlink. Idempotent; re-run to update:
#   cp scripts/pre-commit.sample "$(git rev-parse --git-common-dir)/hooks/pre-commit" \
#     && chmod +x "$(git rev-parse --git-common-dir)/hooks/pre-commit"
#
# Hooks live in the COMMON gitdir, which every worktree of this repo shares —
# so ONE install covers the main checkout and every present and future
# worktree. (In a worktree, `.git` is a FILE pointing at the real gitdir;
# installing into `.git/hooks` from inside one would not work.)
#
# Verify — DIFF the installed copy against this file. Do NOT use `ls -l`:
#   diff "$(git rev-parse --git-common-dir)/hooks/pre-commit" scripts/pre-commit.sample \
#     && test -x "$(git rev-parse --git-common-dir)/hooks/pre-commit" && echo "hook current"
#
# Uninstall:
#   rm "$(git rev-parse --git-common-dir)/hooks/pre-commit"
#
# WHY A COPY AND NOT A SYMLINK — measured, not theoretical:
#
#   A symlink into `scripts/` binds the hook to the WORKING TREE, so the hook
#   becomes whatever the main checkout has checked out at the moment of each
#   commit, in every worktree. `main` does not contain `scripts/` at all, so
#   the link DANGLES there -- and:
#
#     GIT SILENTLY SKIPS A DANGLING HOOK. `git commit` exits 0, the commit is
#     created, and there is NO warning, error or output. The `git checkout`
#     that caused it is equally silent: it prints only "Switched to branch X".
#
#   So checking out the most ordinary branch in the repo would disable
#   enforcement team-wide, with nothing anywhere reporting it. A copy is
#   pinned at install time and immune to that.
#
#   A NON-EXECUTABLE HOOK IS ALSO SILENTLY SKIPPED -- same class, and reachable
#   by a `chmod` sweep without anyone touching this file. That is why the
#   install does `chmod +x` and the verify step tests `-x` explicitly. This
#   repo has had file-mode churn before (Phase 1 flipped 18 files 644/755).
#
#   `ls -l` cannot see ANY of these: it reports that something is installed,
#   not that the correct code will run. Presence, executability and content are
#   three separate properties and git reports none of them at failure time.
#
# STALENESS — the cost of copying, stated plainly:
#
#   A copy does NOT update when this file changes. CHANGING THIS HOOK REQUIRES
#   REINSTALLING IT, everywhere it is installed. The `diff` verify step above
#   detects that, and HOOK-VERSION gives a quick eyeball check.
#
#   This is a real cost and it was chosen deliberately: a stale hook still RUNS
#   and still CHECKS -- it is merely an older version, with CI on push as the
#   authority. A dangling one does not run at all and says nothing. A stale
#   check beats an absent one.
#
# Bypass for a single commit (use sparingly, and never for a config change):
#   git commit --no-verify
#
# WHAT THIS CHECKS, PRECISELY — it matters, because the two differ:
#
#   This hook checks the WORKING TREE. Git commits the STAGED INDEX. Under
#   partial staging — which this repo's pathspec-staging rule makes the NORM,
#   not the exception — those diverge, in BOTH directions:
#
#     FALSE BLOCK: your staged change is clean, but unstaged WIP elsewhere in
#                  teams/ violates an invariant. The commit is refused for
#                  something you were not committing.
#     FALSE PASS:  your staged change violates an invariant, but the working
#                  tree has already been fixed. The hook sees the fix and lets
#                  it through.
#
#   CI on push is the authority; this hook is a fast local warning, not a
#   guarantee. Index-accurate checking would need a staged-snapshot checkout
#   and is deliberately not implemented here.
#
# It runs no network calls and needs no credentials.

set -e

# Only bother when something under teams/ or scripts/ is staged; editing a
# README should not pay for a full invariant sweep.
if git diff --cached --name-only | grep -qE '^(teams/|scripts/)'; then
    root="$(git rev-parse --show-toplevel)"
    echo "pre-commit: checking DevChain config invariants…"
    if ! python3 "$root/scripts/check-invariants.py"; then
        echo ""
        echo "pre-commit: FAILED — config invariants violated. Commit aborted."
        echo "  Re-run manually:  python3 scripts/check-invariants.py"
        echo "  If you changed model pins, regenerate the composed JSON:"
        echo "      python3 compose.py teams/<preset>"
        echo "  Bypass (discouraged):  git commit --no-verify"
        exit 1
    fi

    # --- staleness self-check (WARN ONLY) -------------------------------
    # Placed INSIDE the trigger, i.e. AFTER the early exit, deliberately: the
    # hook's currency matters exactly when its verdict matters. On a docs-only
    # commit this hook checks nothing, so drift is harmless by construction and
    # a warning there would be pure noise. Do not move this above the early
    # exit without revisiting that trade-off.
    #
    # WARN, never fail:
    #   (a) "installed newer than this worktree's source" is NORMAL worktree
    #       life -- a worktree on an older branch is not an error, so failing
    #       would be wrong in one of the two directions.
    #   (b) The stale-audit hard-fail precedent does NOT transfer: that remedy
    #       is committable content that can ride the blocked commit. This
    #       remedy is an environment action (reinstall), which a blocked commit
    #       cannot carry. CI backstops the invariants either way.
    #   Warn-fatigue is an accepted residual, bounded by a one-line remedy.
    #
    # set -e FOOTGUN: this file runs under `set -e`. Every probe below is in a
    # condition context or has explicit `|| true`. A bare grep that found no
    # HOOK-VERSION line would exit 1 and kill the hook -- turning a warn-only
    # check into a commit blocker.
    #
    # Greps here obey the repo's own gating-grep rule: positive match or
    # captured output only, never negated-and-quieted. This is the first new
    # code written after that rule and is meant to be its exemplar.
    hook_ver() {
        # captured output, positive match; never gates on exit status
        sed -n 's/^# HOOK-VERSION:[[:space:]]*\([0-9][0-9]*\)[[:space:]]*$/\1/p' "$1" 2>/dev/null | head -1
    }
    src="$root/scripts/pre-commit.sample"
    if [ -r "$src" ]; then                      # absent (e.g. on main) -> quiet no-op
        same_content=no
        if cmp -s "$0" "$src"; then same_content=yes; fi
        iv="$(hook_ver "$0" || true)"
        sv="$(hook_ver "$src" || true)"
        numeric=no
        case "$iv$sv" in
            ''|*[!0-9]*) numeric=no ;;
            *) [ -n "$iv" ] && [ -n "$sv" ] && numeric=yes ;;
        esac
        if [ "$same_content" = yes ]; then
            :                                    # identical -> silent
        elif [ "$numeric" != yes ]; then
            # unparseable on either side is NEVER treated as equal
            echo "pre-commit: hook version unknown (installed='$iv' source='$sv') — cannot compare; re-run the install line in the hook header" >&2
        elif [ "$iv" -lt "$sv" ]; then
            echo "pre-commit: hook differs from this worktree's source (installed older) — re-run the install line in the hook header" >&2
        elif [ "$iv" -gt "$sv" ]; then
            echo "pre-commit: this worktree's source is behind the installed hook (worktree on an older branch?) — no action needed" >&2
        else
            echo "pre-commit: content differs but versions match — the source's HOOK-VERSION was likely not bumped; bump it and reinstall" >&2
        fi
    fi
fi

exit 0
